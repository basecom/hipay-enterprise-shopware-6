{
    "name": "basecom/sw6-template-theme",
    "description": "basecom Template Theme",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "basecom GmbH & Co. KG",
            "email": "info@basecom.de",
            "homepage": "https://basecom.de",
            "role": "Manufacturer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Basecom\\TemplateTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Basecom\\TemplateTheme\\Tests\\": "tests/"
        }
    },
    "repositories": {
        "papple": {
            "type": "composer",
            "url": "https://papple.bsc.basecom.cloud/get",
            "exclude": ["basecom/sw6-fixtures-plugin"]
        }
    },
    "extra": {
        "shopware-plugin-class": "Basecom\\TemplateTheme\\TemplateTheme",
        "label": {
            "de-DE": "basecom Template Theme",
            "en-GB": "basecom Template Theme"
        },
        "copyright": "(c) basecom GmbH & Co. KG",
        "plugin-icon": "src/Resources/config/plugin.png",
        "description": {
            "de-DE": "TemplateTheme",
            "en-GB": "TemplateTheme"
        }
    },
    "require": {
        "shopware/core": "6.6.6.0",
        "shopware/administration": "6.6.6.0",
        "shopware/storefront": "6.6.6.0",
        "basecom/sw6-fixtures-plugin": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.4",
        "phpunit/phpunit": "^9.6",
        "vimeo/psalm": "^5.0 || ^6.0",
        "symfony/browser-kit": "^7.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
