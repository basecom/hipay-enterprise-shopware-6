{
    "license": "proprietary",
    "type": "project",
    "require": {
        "composer-runtime-api": "^2.0",
        "basecom/sw6-custom-fields-plugin": "4.0.0",
        "basecom/sw6-fixtures-plugin": "3.0.0",
        "frosh/tools": "^2.1",
        "hipay/hipay-enterprise-shopware-6": "dev-bugfix/HIP-13-error-checkout-hipay-credentials",
        "shopware/administration": "6.6.10.5",
        "shopware/core": "6.6.10.5",
        "shopware/elasticsearch": "6.6.10.5",
        "shopware/paas-meta": "6.4.16.3",
        "shopware/storefront": "6.6.10.5",
        "symfony/flex": "~2",
        "symfony/redis-messenger": "^7.1",
        "symfony/runtime": "^7.0"
    },
    "repositories": {
        "shopware": {
            "type": "composer",
            "url": "https://packages.shopware.com"
        },
        "papple": {
            "type": "composer",
            "url": "https://papple.bsc.basecom.cloud/get"
        },
        "0": {
            "type": "path",
            "url": "custom/static-plugins/*",
            "options": {
                "symlink": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-b824-t6kf-bqqz",
                "PKSA-6wp3-462p-vyty",
                "PKSA-h5dj-jyqc-4fjr",
                "PKSA-kypv-cx5n-qkc8",
                "PKSA-v415-g75g-bqsy",
                "PKSA-365x-2zjk-pt47",
                "PKSA-w3qy-s9h7-2hqr"
            ]
        }
    },
    "scripts": {
        "auto-scripts": {
            "assets:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "endpoint": ["https://raw.githubusercontent.com/shopware/recipes/flex/main/index.json", "flex://defaults"],
            "docker": false
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "shopware/dev-tools": "^1.3",
        "symfony/browser-kit": "^7.0",
        "symfony/stopwatch": "^7.1",
        "symfony/web-profiler-bundle": "^7.1"
    }
}
