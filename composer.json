{
    "license": "proprietary",
    "type": "project",
    "require": {
        "composer-runtime-api": "^2.0",
        "basecom/sw6-custom-fields-plugin": "4.0.0",
        "basecom/sw6-fixtures-plugin": "3.0.0",
        "frosh/tools": "^2.1",
        "hipay/hipay-enterprise-shopware-6": "3.0.0",
        "shopware/administration": "6.6.8.2",
        "shopware/core": "6.6.8.2",
        "shopware/elasticsearch": "6.6.8.2",
        "shopware/paas-meta": "6.4.16.2",
        "shopware/storefront": "6.6.8.2",
        "symfony/flex": "~2",
        "symfony/redis-messenger": "^7.1",
        "symfony/runtime": "^7.0"
    },
    "repositories": {
        "shopware": {
            "type": "composer",
            "url": "https://packages.shopware.com"
        },
        "papple": {
            "type": "composer",
            "url": "https://papple.bsc.basecom.cloud/get",
            "exclude": ["hipay/hipay-enterprise-shopware-6"]
        },
        "0": {
            "type": "path",
            "url": "custom/static-plugins/*",
            "options": {
                "symlink": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "assets:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "endpoint": ["https://raw.githubusercontent.com/shopware/recipes/flex/main/index.json", "flex://defaults"],
            "docker": false
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "shopware/dev-tools": "^1.3",
        "symfony/browser-kit": "^7.0",
        "symfony/stopwatch": "^7.1",
        "symfony/web-profiler-bundle": "^7.1"
    }
}
