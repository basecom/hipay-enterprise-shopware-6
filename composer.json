{
    "license": "proprietary",
    "type": "project",
    "require": {
        "composer-runtime-api": "^2.0",
        "shopware/administration": "6.5.7.3",
        "shopware/core": "6.5.7.3",
        "shopware/elasticsearch": "6.5.7.3",
        "shopware/paas-meta": "6.4.16.2",
        "shopware/storefront": "6.5.7.3",
        "symfony/flex": "~2",
        "symfony/runtime": "^5.0|^6.0",

        "basecom/sw6-template-theme": "dev-main",
        "basecom/sw6-fixtures-plugin": "2.4.0",
        "basecom/sw6-custom-fields-plugin": "4.0.0"
    },
    "repositories": {
        "shopware": {
            "type": "composer",
            "url": "https://packages.shopware.com"
        },
        "papple": {
            "type": "composer",
            "url": "https://papple.bsc.basecom.cloud/get"
        },
        "0": {
            "type": "path",
            "url": "custom/plugins/*",
            "options": {
                "symlink": true
            }
        },
        "1": {
            "type": "path",
            "url": "custom/plugins/*/packages/*",
            "options": {
                "symlink": true
            }
        },
        "2": {
            "type": "path",
            "url": "custom/static-plugins/*",
            "options": {
                "symlink": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "assets:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "endpoint": [
                "https://raw.githubusercontent.com/shopware/recipes/flex/main/index.json",
                "flex://defaults"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "shopware/dev-tools": "^1.2",
        "symfony/browser-kit": "^7.0",
        "symfony/stopwatch": "^6.3",
        "symfony/web-profiler-bundle": "^6.3"
    }
}
